# Copy to .env for local overrides. Never commit the resulting .env file.
COMPOSE_PROJECT_NAME=capstone-n3
WEB_PORT=3000
API_PORT=8000
ADMIN_PORT=8501

# Default product path. Set deterministic_offline only for no-cost fixture demos.
FOUNDER_CASE_FIXTURE_MODE=live
DDA_RUNTIME_PROFILE=local
# Custom exporter emits sanitized fields only; leave LANGSMITH_API_KEY blank to disable sending.
DDA_LANGSMITH_TRACING=true
DDA_AUDIT_REQUIRED=true
NEXT_PUBLIC_ADMIN_CONSOLE_URL=http://localhost:8501/

# Optional live-mode credentials. Keep values empty in this tracked example.
OPENAI_API_KEY=
OPENAI_STARTUP_API_KEY=
LANGSMITH_API_KEY=
