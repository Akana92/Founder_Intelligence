# Next.js acceptance output is generated third-party compiler/runtime code, not
# reviewable source. Keep authored acceptance evidence, but exclude only the
# rebuildable frontend .next caches so source-diff audits cannot misclassify
# bundled dependency code as a project fallback or workaround.
/frontend/founder/.next*/
/artifacts/acceptance/**/frontend/.next*/

