<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title>{{ founder_view.title_ru }}</title>
  <style>
    :root { color-scheme: light; }
    body { font-family: Arial, sans-serif; color: #1f252b; margin: 32px; line-height: 1.45; }
    h1 { font-size: 26px; margin: 0 0 4px; }
    h2 { font-size: 18px; margin: 0; }
    h3 { font-size: 14px; margin: 14px 0 6px; }
    p { margin: 6px 0; }
    ul { margin: 6px 0 0; padding-left: 22px; }
    section { margin: 18px 0; page-break-inside: avoid; }
    .report-header { border-bottom: 2px solid #334155; padding-bottom: 14px; }
    .subtitle { color: #334155; font-size: 16px; }
    .muted { color: #5d6875; }
    .section-card { border: 1px solid #d6dde5; border-radius: 8px; padding: 16px; }
    .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .status { border-radius: 999px; font-size: 12px; font-weight: bold; padding: 4px 9px; white-space: nowrap; }
    .status-confirmed { background: #dcfce7; color: #166534; }
    .status-partial { background: #fef3c7; color: #92400e; }
    .status-needs_input { background: #ffedd5; color: #9a3412; }
    .status-contradiction { background: #fee2e2; color: #991b1b; }
    .blocker { border-left: 3px solid #c2410c; padding-left: 10px; }
    .proposal { border-left: 3px solid #4f46e5; margin: 12px 0; padding: 2px 0 2px 12px; page-break-inside: avoid; }
    .proposal-label { color: #4338ca; font-size: 12px; font-weight: bold; text-transform: uppercase; }
    .charts { border: 1px solid #d6dde5; border-radius: 8px; padding: 16px; }
    .chart { max-width: 560px; width: 100%; }
    details { border-top: 1px solid #cbd5e1; margin-top: 28px; padding-top: 12px; }
    details summary { cursor: pointer; font-weight: bold; }
  </style>
</head>
<body>
  <header class="report-header">
    <h1>{{ founder_view.title_ru }}</h1>
    <p class="subtitle">{{ founder_view.subtitle_ru }}</p>
    <p class="muted">Дата среза: {{ founder_view.as_of_ru }} · Версия данных: {{ founder_view.data_revision }}</p>
  </header>
  {% if startup_charts %}
  <section class="charts" data-startup-charts>
    <h2>Диаграммы по подтверждённым данным</h2>
    {% for chart in startup_charts %}
    <figure data-startup-chart="{{ chart["key"] }}">
      {% if chart["key"] == "market_sizing" %}
      <figcaption>Размер рынка — только значения из строк с источниками.</figcaption>
      <img class="chart" alt="Диаграмма размера рынка" src="{{ chart["chart_data_uri"] }}">
      {% elif chart["key"] == "confirmed_metrics" %}
      <figcaption>Подтверждённые метрики — только локальные расчёты.</figcaption>
      <img class="chart" alt="Диаграмма подтверждённых метрик" src="{{ chart["chart_data_uri"] }}">
      {% elif chart["key"] == "readiness_coverage" %}
      <figcaption>Готовность метрик — распределение по проверенным статусам.</figcaption>
      <img class="chart" alt="Диаграмма готовности метрик" src="{{ chart["chart_data_uri"] }}">
      {% else %}
      <figcaption>Покрытие отчёта — состояние двенадцати основных разделов.</figcaption>
      <img class="chart" alt="Диаграмма покрытия отчёта" src="{{ chart["chart_data_uri"] }}">
      {% endif %}
    </figure>
    {% endfor %}
  </section>
  {% endif %}
  {% for section in founder_view.main_sections %}
  <section id="{{ section.key }}" class="section-card" data-founder-status="{{ section.status }}">
    <div class="section-heading">
      <h2>{{ section.title_ru }}</h2>
      <span class="status status-{{ section.status }}">{{ section.status_label_ru }}</span>
    </div>
    <p>{{ section.summary_ru }}</p>
    {% if section.known_facts_ru %}
    <h3>{{ section.content_heading_ru }}</h3>
    <ul>
      {% for item in section.known_facts_ru %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if section.blockers_ru %}
    <h3>Блокеры</h3>
    <ul class="blocker">
      {% for item in section.blockers_ru %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if section.next_data_ru %}
    <h3>Что добавить</h3>
    <ul>
      {% for item in section.next_data_ru %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if section.unlocks_ru %}
    <h3>Что это откроет</h3>
    <ul>
      {% for item in section.unlocks_ru %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
    {% endif %}
  </section>
  {% endfor %}
  <section aria-labelledby="improvement-proposals-title">
    <h2 id="improvement-proposals-title">Предложения ИИ по улучшению</h2>
    <p class="muted">Это рекомендации, а не подтверждённые факты. Решение о применении остаётся за основателем.</p>
    {% for proposal in founder_view.improvement_proposals %}
    <article class="proposal" data-improvement-area="{{ proposal.target_area }}">
      <p class="proposal-label">{{ proposal.title_ru }}</p>
      <p><strong>Рекомендация:</strong> {{ proposal.recommendation_ru }}</p>
      <p><strong>Почему сейчас:</strong> {{ proposal.rationale_ru }}</p>
      <p><strong>Ожидаемый эффект:</strong> {{ proposal.expected_effect_ru }}</p>
    </article>
    {% endfor %}
  </section>
  <details id="technical-appendix">
    <summary>Техническая методология и источники</summary>
    <h3>Методология</h3>
    <ul>
      {% for item in founder_view.technical_appendix.methodology_ru %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
    <h3>Источники</h3>
    <ul>
      {% for item in founder_view.technical_appendix.sources_ru %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
  </details>
</body>
</html>
